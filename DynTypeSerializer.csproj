<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Package identity -->
    <PackageId>DynTypeSerializer</PackageId>
    <Version>1.0.0</Version>
    <Authors>Vaino Karppi</Authors>
    <Description>A fully dynamic, type-preserving JSON serializer for .NET built on System.Text.Json. Embeds runtime type metadata into the JSON so values can be round-tripped with full fidelity.</Description>
    <PackageTags>json;serializer;dynamic;polymorphic;system.text.json;serialization</PackageTags>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/VainoKarppi/DynTypeSerializer</RepositoryUrl>

    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <NoWarn>IL3002;IL2026;IL2065;IL3050;IL2069;IL3053;IDE0270;IDE0019;IL2062;IL3050;IL2026;IL2067;IL2070;IL2057;IL2075</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The library lives at the repository root, so exclude the test
         project from its default **/*.cs glob. -->
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>